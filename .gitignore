cat > .gitignore <<'EOF'
.env
.env.*
!.env.example
*.pem
*.key
secrets/
EOF

monitoring/.env
terraform/.terraform/
terraform/terraform.tfstate
terraform/terraform.tfstate.backup

# Runtime logs and generated incident reports
logs/
reports/

# Local configuration backups
monitoring/compose.yaml.bak
scripts/*.bak
scripts/*.bak
